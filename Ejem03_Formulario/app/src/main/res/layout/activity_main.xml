<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvEligeCurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:text="Selecciona tu curso:"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/rgCursos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/rgCursos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvEligeCurso"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rbCurso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:text="Primero" />

        <RadioButton
            android:id="@+id/rbCurso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:text="Segundo" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvTipoMatricula"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:text="Elige tipo de matrícula:"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/spTipoMatricula"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rgCursos" />


    <Spinner
        android:id="@+id/spTipoMatricula"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:entries="@array/tiposMatricula"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toEndOf="@id/tvTipoMatricula"
        app:layout_constraintTop_toBottomOf="@id/rgCursos" />

</androidx.constraintlayout.widget.ConstraintLayout>